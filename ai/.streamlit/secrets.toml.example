# Template for Streamlit secrets configuration
# Copy this file to secrets.toml and fill in your actual credentials

[mongodb]
uri = "mongodb://localhost:27017"
database = "safegraph_ai"
collection_weather = "weather_history"
collection_predictions = "heatwave_predictions"

[weather_api]
open_meteo_url = "https://api.open-meteo.com/v1/forecast"
erode_lat = 11.3410
erode_lon = 77.7172
timezone = "Asia/Kolkata"

[gemini]
# Optional: Provide Google Gemini API Key for natural language LLM responses
api_key = ""

[openai]
# Optional: Provide OpenAI API Key for natural language LLM responses
api_key = ""

