# ==========================================
# Datasets & Data Files
# ==========================================
# Exclude raw and processed datasets (keep folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Common data file formats
*.csv
*.parquet
*.feather
*.xlsx
*.xls
*.h5
*.hdf5
*.nc
*.nc4
*.zip
*.tar.gz
*.gz

